# Copy to .env for local development. NEVER commit the real .env file.
# In production these are set as environment variables on the hosting provider (see docs/DEPLOYMENT.md).

# Public URL of the app, no trailing slash. Must be https:// in production.
BASE_URL=http://localhost:8000

# Random string used to sign session cookies.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Secret used to encrypt the Gmail refresh token in the database: any random string of 24+ characters,
# or a Fernet key generated with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me

# Only this Google account can sign in.
ALLOWED_EMAIL=you@gmail.com

# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application").
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Local: SQLite file. Production: your PostgreSQL connection string, e.g.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///jobmail.db

# Optional: turns on AI sorting, job-fit scoring and reply drafting.
# Create a key at https://console.anthropic.com (usage is billed; set a spend limit there).
ANTHROPIC_API_KEY=
#AI_MODEL=claude-haiku-5-5
#AI_COMPOSE_MODEL=claude-sonnet-5-5

# Optional tuning
SYNC_DAYS=90
SYNC_BATCH=40
